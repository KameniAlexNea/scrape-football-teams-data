# --- Claude agent (claude-agent-sdk) --------------------------------------
# The SDK spawns the `claude` CLI (Claude Code). Two ways to configure it:
#   1. The `claude` CLI is already installed and logged in -> set nothing here
#      (the API key comes from Claude Code's own config).
#   2. Point at any Anthropic-Messages-compatible endpoint:
#      - official API: ANTHROPIC_API_KEY is enough
#      - gateway / self-hosted: also set ANTHROPIC_BASE_URL

# Anthropic API key (optional if the `claude` CLI is logged in)
ANTHROPIC_API_KEY=

# Anthropic-compatible endpoint ("specific link"). Leave blank for the
# official Anthropic API. Examples:
#   https://api.anthropic.com
#   http://localhost:8000/v1
ANTHROPIC_BASE_URL=

# Model override (takes precedence over FOOTY_MODEL)
ANTHROPIC_MODEL=

# Default model used for the extraction agent
FOOTY_MODEL=claude-sonnet-4-5

# Run the browser headless (true) or headed (false) — set false to watch it work
FOOTY_HEADLESS=true

# Directory where league JSON files and screenshots are written
FOOTY_OUTPUT_DIR=data

# Navigation timeout for Playwright, in milliseconds
FOOTY_TIMEOUT_MS=30000

# Max characters of page text handed to the model per snapshot
FOOTY_SNAPSHOT_MAX_CHARS=30000
